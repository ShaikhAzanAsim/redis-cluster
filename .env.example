# Copy this file to .env and adjust as needed.

AIS_REDIS_PASSWORD=Verseye!23

# Comma-separated host:port list of cluster startup nodes. Only one needs to
# be reachable for the client to discover the rest of the topology, but all
# 9 are listed here for resilience against any single node being down.
AIS_REDIS_CLUSTER_NODES=172.30.0.11:6379,172.30.0.12:6379,172.30.0.13:6379,172.30.0.14:6379,172.30.0.15:6379,172.30.0.16:6379,172.30.0.17:6379,172.30.0.18:6379,172.30.0.19:6379

# Whether the client should distribute read commands across replicas.
AIS_REDIS_CLUSTER_READ_FROM_REPLICAS=true

AIS_REDIS_LOGS_LIMIT=50
